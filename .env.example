# Базовый URL бэкенда (FastAPI).
# Админ-эндпоинты бэкенда монтируются как {ADMIN_API_BASE}/admin/...
# Примеры:
#   ADMIN_API_BASE=http://localhost:8000
#   ADMIN_API_BASE=https://api.clinic.com/v1
ADMIN_API_BASE=http://localhost:8000

# Секрет для проверки подписи JWT в proxy.ts (src/proxy.ts).
# Если НЕ задан — токен декодируется БЕЗ проверки подписи (только для разработки).
# В production обязательно задайте тот же секрет, что и у бэкенда.
JWT_SECRET=

# Тема по умолчанию: light | dark
DEFAULT_THEME=light

# GlitchTip / Sentry DSN для мониторинга ошибок и логов в админке
# Пример: https://publicKey@glitchtip.yourdomain.ru/2
NEXT_PUBLIC_GLITCHTIP_DSN=
